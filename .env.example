# Firebase Web App settings from the NEW Firebase project. Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tennis-club-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tennis-club-system
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Set these in Vercel, never NEXT_PUBLIC_*.
FIREBASE_PROJECT_ID=tennis-club-system
FIREBASE_CLIENT_EMAIL=
# PEM private key: real newlines or literal \n are supported. No surrounding quotes in Vercel.
FIREBASE_PRIVATE_KEY=

# Local ADC: run gcloud auth application-default login
# Never commit service account JSON or private keys to Git.
