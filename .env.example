# Firebase Web App settings from the NEW Firebase project. Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. ADC on Cloud Run / Firebase App Hosting.
FIREBASE_PROJECT_ID=

# Local ADC: run gcloud auth application-default login
# Never commit service account JSON or private keys to Git.
